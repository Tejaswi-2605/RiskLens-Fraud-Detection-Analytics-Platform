# ---- Data: NEVER commit. Regenerate via scripts/download_data.py ----
# Leading slash anchors these to the repo root, so they do NOT accidentally
# match the source package `src/risklens/data/`.
/data/
*.csv
*.parquet
*.zip

# ---- Trained artefacts: regenerable, and binary ----
# These are outputs, not source. Committing them bloats history permanently
# (git stores every version of a binary in full) and they change on every
# retrain. Anyone can rebuild them from the scripts; reproducibility comes
# from the SHA-256 manifest in reports/, not from storing the bytes.
/models/
/indexes/

# ---- Secrets ----
kaggle.json
.env
*.pem

# ---- Environment ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- Logs: console output, not results. The JSON/CSV in reports/ IS kept. ----
reports/*.txt
reports/*_log.txt

# ---- Tooling / OS ----
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.vscode/
